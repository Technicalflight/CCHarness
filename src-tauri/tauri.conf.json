{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CCHarness",
  "version": "0.1.0",
  "identifier": "com.ccharness.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CCHarness",
        "width": 1400,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "shadow": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
